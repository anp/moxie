load("@rules_rust//rust:defs.bzl", "rust_proc_macro", "rust_test")

package(default_visibility = ["//visibility:public"])

rust_proc_macro(
    name = "illicit-macro",
    # FIXME translate this metadata somehow
    # description = "procedural macros for the illicit crate"
    # readme = "../CHANGELOG.md"
    srcs = [
        "src/lib.rs",
    ],
    edition = "2018",
    lint_config = "//:library_lints",
    version = "1.0.0",
    deps = [
        "@crates//:proc-macro-error",
        "@crates//:quote",
        "@crates//:syn",
    ],
)

rust_test(
    name = "illicit-macro_unit_tests",
    crate = "illicit-macro",
)

test_suite(
    name = "tests",
    tests = [
        ":illicit-macro_unit_tests",
    ],
)
