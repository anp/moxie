load("@rules_rust//rust:defs.bzl", "rust_library", "rust_shared_library")
load("@rules_rust_wasm_bindgen//:defs.bzl", "rust_wasm_bindgen", "rust_wasm_bindgen_test")

package(default_visibility = ["//visibility:public"])

# FIXME translate
# [package.metadata.docs.rs]
# default-target = "wasm32-unknown-unknown"
# all-features = true

# [features]
# default = ["webdom"]
# rsdom = ["illicit"]
# webdom = ["gloo-timers", "js-sys", "prettiest", "wasm-bindgen", "web-sys"]

version = "0.2.0-pre"

edition = "2018"

library_lints = "//:library_lints"

# FIXME actually expand the test matrix
crate_features = [
    "rsdom",
    "webdom",
]

lib_srcs = glob(["src/**/*.rs"])

lib_deps = [
    "@crates//:gloo-timers",
    "@crates//:quick-xml",
    "@crates//:static_assertions",
    "@crates//:tracing",
    "@crates//:futures",

    # rsdom dependencies FIXME make optional
    "//illicit",

    # webdom dependencies FIXME make optional
    "//web/prettiest",
    "@crates//:js-sys",
    "@crates//:wasm-bindgen",
    "@crates//:web-sys",
]

lib_proc_macro_deps = [
    "@crates//:paste",
]

rust_library(
    name = "augdom",
    srcs = lib_srcs,
    crate_features = crate_features,
    # description = "DOM API usable both inside of a browser (web-sys) and outside (emulation)."
    # categories = ["api-bindings", "emulators", "gui", "wasm", "web-programming"]
    # keywords = ["dom", "incremental"]
    # readme = "CHANGELOG.md"
    edition = edition,
    lint_config = library_lints,
    proc_macro_deps = lib_proc_macro_deps,
    version = version,
    deps = lib_deps,
)

rust_shared_library(
    name = "augdom_shared",
    srcs = lib_srcs,
    crate_features = crate_features,
    edition = edition,
    lint_config = library_lints,
    proc_macro_deps = lib_proc_macro_deps,
    deps = lib_deps,
)

rust_wasm_bindgen(
    name = "augdom_wasm_bindgen",
    target = "web",
    wasm_file = ":augdom_shared",
)

rust_wasm_bindgen_test(
    name = "augdom_wasm_bindgen_test",
    crate_features = crate_features,
    wasm = "augdom_wasm_bindgen",
)
