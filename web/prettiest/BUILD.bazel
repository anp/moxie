load("@rules_rust//rust:defs.bzl", "rust_library", "rust_shared_library")
load("@rules_rust_wasm_bindgen//:defs.bzl", "rust_wasm_bindgen", "rust_wasm_bindgen_test")
# load("//:build/wasm_bindgen_test.bzl", "rust_wasm_bindgen_test")

package(default_visibility = ["//visibility:public"])

lib_deps = [
    "@crates//:futures",
    "@crates//:js-sys",
    "@crates//:scopeguard",
    "@crates//:wasm-bindgen",
    "@crates//:web-sys",
]

rust_library(
    name = "prettiest",
    # keywords = [
    #     "debug",
    #     "pretty",
    #     "javascript",
    # ],
    srcs = glob(["src/**/*.rs"]),
    # categories = ["web"],
    # description = "Pretty-printer for JS values from wasm-bindgen.",
    edition = "2018",
    lint_config = "//:library_lints",
    # readme = "CHANGELOG.md",
    version = "0.2.1",
    deps = lib_deps,
)

rust_shared_library(
    name = "prettiest_shared",
    srcs = glob(["src/**/*.rs"]),
    edition = "2018",
    lint_config = "//:library_lints",
    deps = lib_deps,
)

rust_wasm_bindgen(
    name = "prettiest_wasm_bindgen",
    target = "web",
    wasm_file = ":prettiest_shared",
)

rust_wasm_bindgen_test(
    name = "prettiest_wasm_bindgen_test",
    wasm = "prettiest_wasm_bindgen",
)
