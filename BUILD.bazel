load("@rules_rust//rust:defs.bzl", "rust_lint_config")

package(default_visibility = ["//visibility:public"])

# # update here, update everywhere!
# license = "MIT/Apache-2.0"
# homepage = "https://moxie.rs"
# repository = "https://github.com/anp/moxie.git"
# authors = ["Adam Perry <lol@anp.lol>"]

test_suite(
    name = "core_library_tests",
    tests = [
        "//dyn-cache:tests",
        "//illicit:tests",
        "//mox:tests",
        "//moxie:tests",
        "//topo:tests",
    ],
)

clippy_lint_config = {
    "all": "warn",
}

default_rustc_lint_config = {
    "missing_docs": "warn",
    # FIXME make conditional on CI or something?
    "warnings": "deny",
}

deny_unsafe_rustc_lint = {"unsafe_code": "deny"}

forbid_unsafe_rustc_lint = {"unsafe_code": "deny"}

rust_lint_config(
    name = "library_lints",
    clippy = clippy_lint_config,
    rustc = default_rustc_lint_config | forbid_unsafe_rustc_lint,
)

rust_lint_config(
    name = "library_lints_allowing_unsafe",
    clippy = clippy_lint_config,
    rustc = default_rustc_lint_config | deny_unsafe_rustc_lint,
)

exports_files(
    srcs = [
        "clippy.toml",
        "rustfmt.toml",
    ],
    visibility = ["//visibility:public"],
)
