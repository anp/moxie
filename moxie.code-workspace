{
    "folders": [
        {
            "path": "."
        }
    ],
    "extensions": {
        "recommendations": [
            "BazelBuild.vscode-bazel",
            "DavidAnson.vscode-markdownlint",
            "rust-lang.rust-analyzer",
        ]
    },
    "settings": {
        "bazel.executable": "bazelisk",
        "[rust]": {
            "editor.rulers": [
                100
            ],
        },
    },
    "tasks": {
        "version": "2.0.0",
        "tasks": [
            {
                "label": "Build everything",
                "type": "bazel",
                "command": "build",
                "targets": [
                    "//..."
                ],
                "presentation": {
                    "panel": "dedicated",
                    "showReuseMessage": false,
                    "clear": true
                },
                "group": {
                    "kind": "build",
                    "isDefault": true
                }
            },
            {
                "label": "Test everything",
                "type": "bazel",
                "command": "test",
                "targets": [
                    "//..."
                ],
                "presentation": {
                    "panel": "dedicated",
                    "showReuseMessage": false,
                    "clear": true
                },
                "group": {
                    "kind": "test",
                    "isDefault": true
                }
            },
        ]
    },
}